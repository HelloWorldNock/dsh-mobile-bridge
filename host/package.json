{
  "name": "dsh-mobile-bridge",
  "version": "0.8.1",
  "description": "LAN and Tailscale bridge that lets an Android phone drive DeepSeek Harness sessions: list tasks, prompt, approve tools, review plans and receive notifications. Ships an embedded tailnet node (tailscale.com/tsnet), so the PC needs no Tailscale client.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.png",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "tsnode",
    "locale",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "remote-control",
    "android",
    "lan",
    "tailscale",
    "sse"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test --test-reporter=spec"
  }
}
