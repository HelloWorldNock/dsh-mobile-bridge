# 本地工具链（JDK / Android SDK / Gradle，约 2.7 GB）
.toolchain/

# 构建与打包产物：APK 与插件 tgz 走 GitHub Release，不进仓库
dist/
host/*.tgz

# 本机发现中继配置（含内网地址，提交时用 example 复制）
tools/discovery-relay.json

android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/app/.cxx/
android/local.properties

# 测试残留与依赖
testhome/
test/
node_modules/
*.log
*.err.log

# 内置 Tailscale 节点的运行时状态（节点密钥与日志）
host/.tsnet-state/
.tmp/

# 内置 Tailscale 节点的编译产物（22 MB，走 GitHub Release 附件；
# 从源码安装后跑 tools/build-tsnode.ps1 重新生成）
host/bin/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
