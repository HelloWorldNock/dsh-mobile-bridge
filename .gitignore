# 本地工具链（JDK / Android SDK / Gradle，约 2.7 GB）
.toolchain/

# 构建与打包产物：APK 与插件 tgz 走 GitHub Release，不进仓库
dist/
host/*.tgz

# 本机发现中继配置（含内网地址，提交时用 example 复制）
tools/discovery-relay.json

android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/app/.cxx/
android/local.properties
# 发布签名密钥的路径与口令（只在本机，绝不入库）
android/keystore.properties
*.jks
*.keystore
*.p12

# 口令/密钥的手抄笔记（例如 keytool 生成后随手记的 .txt）——
# release.mjs 会 `git add -A`，所以这里必须挡住，否则一次发版就把私钥笔记推进历史
安装包私钥.txt
*私钥*.txt
*密钥*.txt

# 测试残留与依赖（只有仓库根部的临时 test/ 目录被忽略；
# host/test 与 android/app/src/test 是正式测试，必须入库）
testhome/
/test/
node_modules/
*.log
*.err.log

# 内置 Tailscale 节点的运行时状态（节点密钥与日志）
host/.tsnet-state/
.tmp/

# 内置 Tailscale 节点的编译产物（22 MB，走 GitHub Release 附件；
# 从源码安装后跑 tools/build-tsnode.ps1 重新生成）
host/bin/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
